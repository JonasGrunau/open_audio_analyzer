<?xml version="1.0" encoding="utf-8"?>
<!--
  distribution.xml — the installer's interface, and the three checkboxes.

  SPDX-License-Identifier: GPL-3.0-or-later

  ==========================================================================
  Why the application row cannot be unticked

  The plugins do not analyse anything on their own. They measure the buffer
  the DAW hands them and stream it to the application over 127.0.0.1:47822 —
  loopback, not the network, so the application is always on the same machine
  as the plugin that feeds it. A plugin-only install is a plugin that connects
  to nothing, forever, with no error a DAW would show. So `app` is
  start_selected and start_enabled="false": ticked, and greyed out.

  ==========================================================================
  Why the plugin rows are no longer gated separately

  They used to be, and the gate was right at the time: the application built
  at 10.15 and the plugins at 11.0, so there was a band of macOS versions that
  could run one and not load the others — and on Catalina a DAW given that
  VST3 reported no error at all, the plugin simply being absent from the
  browser, which is indistinguishable from having installed it in the wrong
  folder.

  Both are 14.2 now, because the engine holds a strong reference to
  `CATapDescription` and a strong reference to a class that does not exist is a
  library dyld cannot load at all — see `engine/src/oaa_tap.h`. The band is
  therefore empty, `allowed-os-versions` below refuses the whole volume under
  14.2, and a per-row `system.compareVersions` check could only ever agree with
  it. If the two targets are ever allowed to diverge again, this is the gate to
  bring back.

  ==========================================================================
  customize="always"

  The default install pane has no checkboxes on it — the user has to find the
  Customise button first. `always` opens on the customisation pane instead,
  which is the whole point of shipping a pkg rather than a folder.
-->
<installer-gui-script minSpecVersion="2">
    <title>Open Audio Analyzer</title>

    <options customize="always" hostArchitectures="arm64,x86_64"/>

    <!-- /Library and /Applications, so every user of the machine gets it and
         every DAW looks in one place. Not the home directory: a plugin folder
         under ~/Library is invisible to a DAW another account launched. -->
    <domains enable_anywhere="false" enable_currentUserHome="false"
             enable_localSystem="true"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="14.2"/>
        </allowed-os-versions>
    </volume-check>

    <license file="LICENSE.txt"/>

    <choices-outline>
        <line choice="app"/>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="app"
            title="Open Audio Analyzer"
            description="The application, in /Applications. Required — the plug-ins stream what they measure to it over loopback, so it has to be on this machine."
            start_selected="true" start_enabled="false" visible="true">
        <pkg-ref id="com.openaudioanalyzer.oaa.app"/>
    </choice>

    <choice id="vst3"
            title="VST3 plug-in"
            description="Installs into /Library/Audio/Plug-Ins/VST3, where every VST3 host looks."
            start_selected="true" start_enabled="true" visible="true">
        <pkg-ref id="com.openaudioanalyzer.oaa.vst3"/>
    </choice>

    <choice id="au"
            title="Audio Unit"
            description="Installs into /Library/Audio/Plug-Ins/Components, for Logic, GarageBand and other AU hosts."
            start_selected="true" start_enabled="true" visible="true">
        <pkg-ref id="com.openaudioanalyzer.oaa.au"/>
    </choice>

    <pkg-ref id="com.openaudioanalyzer.oaa.app"  onConclusion="none">app.pkg</pkg-ref>
    <pkg-ref id="com.openaudioanalyzer.oaa.vst3" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.openaudioanalyzer.oaa.au"   onConclusion="none">au.pkg</pkg-ref>
</installer-gui-script>
