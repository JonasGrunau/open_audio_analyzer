# Response headers for the deploy. Cloudflare Workers static assets reads this
# file out of the asset directory — Astro copies it from public/ into dist/, and
# `wrangler deploy` applies it. It is not itself served.
#   https://developers.cloudflare.com/workers/static-assets/headers
#
# Without it everything falls to the platform default, which is
# `public, max-age=0, must-revalidate` — correct and pessimistic: an ETag round
# trip for a typeface that will never change again. Nothing in dist/ is
# content-hashed (the CSS and JS are inlined into the HTML, so there is no
# _astro/ directory to fingerprint), which is why the long lifetimes below are
# granted by path rather than by build and why only one of them is `immutable`.
#
# `scripts/lib/headless.mjs` parses this file when it serves dist/ for
# `npm run audit`, so the score is measured against these headers rather than
# against a bare local server. It is the source; there is no second copy.

# The safe default. Once the rules below have claimed the assets, what is left
# matching this is the HTML, which must never be stale: a deploy is meant to be
# visible immediately and every page is 17–240 kB of markup with the stylesheet
# inside it.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # A year of HTTPS-only for this host. Deliberately without `includeSubDomains`
  # and without `preload`: both extend the promise past what this repository
  # controls — the first to every future subdomain, the second to a list that is
  # slow to leave — and neither is needed for the apex to be safe.
  Strict-Transport-Security: max-age=31536000
  # No Content-Security-Policy. Every stylesheet and every script on this site is
  # inlined, so a useful policy means per-build hashes; it buys no Lighthouse
  # points either, `csp-xss` being informative. Worth doing, not worth doing
  # halfway with 'unsafe-inline', which is the same as not doing it.

# The one directory that is safe to call immutable, because the filenames carry
# the family version: `npm run fonts` writing a new Archivo writes
# archivo-v26-latin.woff2 and deletes the v25, so no URL ever changes meaning.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The committed photographs. Regenerated in place by `npm run modules` and
# `npm run analyzer` under the same names, so `immutable` would be a lie — a
# month is as long as a stale screenshot is tolerable.
/modules/*
  Cache-Control: public, max-age=2592000
/flow/*
  Cache-Control: public, max-age=2592000
/analyzer-still.webp
  Cache-Control: public, max-age=2592000
/og.png
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/icon-180.png
  Cache-Control: public, max-age=2592000
/oaa.svg
  Cache-Control: public, max-age=2592000

# Compiled Flutter, rebuilt by every `npm run deploy` with no change of name.
# A day, because a reader who pressed the button yesterday should not be handed
# last release's analyzer, and it is 6.8 MB nobody fetches unless they press it.
/analyzer/*
  Cache-Control: public, max-age=86400
