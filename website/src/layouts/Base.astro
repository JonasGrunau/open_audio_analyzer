---
/* The typefaces, before the tokens that name them. Both are inlined into every
   page by `inlineStylesheets: 'always'`, so the `@font-face` rules arrive in the
   HTML itself and cost no request — which is the whole reason the files are
   served from this origin instead of Google's. See scripts/fetch-fonts.mjs. */
import '../styles/fonts.css';
import '../styles/global.css';
/* One source for the version, the repository and the host, read from the
   application's own pubspec — see src/lib/app.mjs. */
import { REPO, RELEASES, VERSION, urlFor } from '../lib/app.mjs';
import { homeSchema } from '../lib/schema.mjs';

interface Props {
  title: string;
  description: string;
  path?: string;
  /* The four-column footer is the front page's closing statement. Under a
     documentation page it is a second navigation the reader did not ask for,
     below content that is already long, so those pages take one line. */
  slimFooter?: boolean;
  /* Keeps a page out of the index, and takes its canonical with it. Only `/404`
     uses it: `not_found_handling: "404-page"` serves that one document at every
     address that has none, so a self-referential canonical there is a thousand
     URLs all claiming to be `/404`, and the page itself is a page whose whole
     content is that there is no page. A crawler needs to be able to *read* the
     refusal, which is why this is a meta tag and not a line in robots.txt —
     a disallowed URL is never fetched, so the noindex is never seen and the
     address can stay indexed on the strength of a link alone. */
  noindex?: boolean;
  /* What this page says it is, in JSON-LD. Defaults to the application, which is
     right for the front page and wrong everywhere else — see src/lib/schema.mjs
     for why that mattered. */
  schema?: unknown;
}

const {
  title,
  description,
  path = '/',
  slimFooter = false,
  noindex = false,
  schema,
} = Astro.props;
const canonical = urlFor(path);
const linkedData = schema ?? homeSchema(description);
/* The documentation is part of this site: the repository's own Markdown,
   rendered at /docs. It was a separate GitHub Pages deployment with its own
   generator and its own visual language, which meant two sites to keep and a
   header link that took the reader off the one they were on. */
const DOCS = '/docs';

const nav = [
  { href: '/#workflow', label: 'How it works' },
  { href: '/#modules', label: 'Modules' },
  { href: '/#measurement', label: 'Measurement' },
  { href: '/#reach', label: 'Plugin & CLI' },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="theme-color" content="#0b0c0e" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Open Audio Analyzer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={urlFor('/og.png')} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta
      property="og:image:alt"
      content="Open Audio Analyzer: a canvas of loudness and spectrum meters."
    />
    {/* Twitter reads the og:* tags for everything but the card shape, so there
        are no twitter:title, twitter:description or twitter:image here — they
        would be a second copy of three strings, kept in step by hand. */}
    <meta name="twitter:card" content="summary_large_image" />

    {/* The three latin faces, warmed before layout asks for them. All three are
        on the first screen — Archivo sets the headings, navigation and buttons,
        Google Sans Code the readouts, Source Serif 4 the body prose — and
        `npm run audit` was the thing that settled how many to name here, not
        reasoning about it. Measured on the front page, mobile:

          no preload      first paint 2.1 s   largest 2.4 s
          two of three    first paint 1.2 s   largest 2.6 s
          all three       first paint 0.9 s   largest 2.6 s

        `font-display: swap` means the fallback paints immediately, so the
        expectation was that preloading would not move first paint at all. It
        more than halves it: without a preload the browser does not know a font
        is wanted until it has parsed enough of the page to lay text out, and
        the swap period expires into the fallback before the real face lands.
        The other two subsets — `math` and `symbols`, and every `latin-ext` —
        are deliberately not here: `unicode-range` keeps them unfetched until a
        page contains a glyph that needs one, and preloading would throw that
        away.

        `crossorigin` is not optional and not a copy-paste artefact: a font is
        fetched in CORS mode whatever its origin, so a preload without it is a
        different request from the one the stylesheet makes and the file is
        fetched twice. */}
    <link
      rel="preload"
      href="/fonts/archivo-v25-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/google-sans-code-v17-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-serif-4-v14-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* A 404 describes nothing, so it claims nothing. */}
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(linkedData)} />}
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="bar">
      <div class="bar-in shell">
        <a class="mark" href="/" aria-label="Open Audio Analyzer, home">
          {/* The generated icon, referenced rather than inlined: it is the
              same file the tab shows, so the browser fetches it once, and a
              copy pasted in here is a copy that goes stale. See
              `packaging/icon/make_icons.dart`. */}
          <img src="/favicon.svg" width="18" height="18" alt="" />
          <span class="wordmark">Open Audio Analyzer</span>
        </a>

        <nav aria-label="Sections">
          {nav.map((n) => <a class="navlink" href={n.href}>{n.label}</a>)}
        </nav>

        <div class="bar-end">
          <span class="num ver">{VERSION}</span>
          <a class="navlink" href={REPO} rel="noopener">Source</a>
          <a class="navlink" href={DOCS} rel="noopener">Docs</a>
          <a class="bar-dl" href={RELEASES} rel="noopener">Download</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {slimFooter ? (
      <footer class="foot foot-slim">
        <div class="shell foot-slim-in">
          <span class="num">© 2026 Jonas Grunau</span>
          <span class="foot-slim-links">
            <a class="foot-a" href="/">Home</a>
            <a class="foot-a" href="/docs">Documentation</a>
            <a class="foot-a" href="/privacy">Privacy</a>
            <a class="foot-a" href="/impressum">Legal Notice (Impressum)</a>
            <a class="foot-a" href={REPO} rel="noopener">Repository</a>
            <a class="foot-a" href={RELEASES} rel="noopener">Download</a>
          </span>
        </div>
      </footer>
    ) : (
      <footer class="foot">
        <div class="shell">
          <div class="foot-grid">
            <div class="stack-16">
              <p class="label">Open Audio Analyzer</p>
              <p class="foot-p">
                A free and open-source loudness and spectrum analyzer for desktop and tablets.
                Version {VERSION}.
              </p>
              <p class="foot-p">
                Meters you arrange yourself and save as a preset, on the desktop or on the tablet
                beside it. One layout for tracking, one for mixing, one for the last hour before a
                master goes out.
              </p>
            </div>

            <div class="stack-12">
              <p class="label">Project</p>
              <a class="foot-a" href={REPO} rel="noopener">Repository</a>
              <a class="foot-a" href={DOCS} rel="noopener">Documentation</a>
              <a class="foot-a" href={`${REPO}/releases`} rel="noopener">Releases</a>
              <a class="foot-a" href="/docs/changelog">Changelog</a>
              <a class="foot-a" href="/alternatives/decibel">Compared to Decibel</a>
              <a class="foot-a" href={`${REPO}/issues`} rel="noopener">Issues</a>
              <a class="foot-a" href="/privacy">Privacy</a>
              <a class="foot-a" href="/impressum">Legal Notice (Impressum)</a>
            </div>

            <div class="stack-12">
              <p class="label">Reference</p>
              <a class="foot-a" href="/docs/metrics">Metrics</a>
              <a class="foot-a" href="/docs/keyboard">Keyboard</a>
              <a class="foot-a" href="/docs/wire">Wire protocol</a>
              <a class="foot-a" href="/docs/building">Building</a>
            </div>

            <div class="stack-12">
              <p class="label">Licence</p>
              <p class="foot-lic"><span class="num">GPL-3.0</span> — the engine, the application and everything between</p>
              <p class="foot-lic"><span class="num">AGPL-3.0</span> — the plugin, because it links JUCE</p>
              <p class="foot-lic">
              <span class="num">SIL OFL</span> — the typefaces: Inter in the application,
              <a class="link-quiet" href="/fonts/OFL.txt">Archivo, Source Serif 4 and Google
              Sans Code</a> on this site
            </p>
            </div>
          </div>

          <!-- Not boilerplate, and not optional. Apple's marketing guidelines
               require a credit line naming Apple and the Apple logo wherever
               the App Store badge is shown, and Google's ask the same for the
               Play badge; the badges are in the hero of the front page, which
               is the only page carrying this footer. Neither mark belongs to
               this project and neither store endorses it, which the last
               sentence is there to say. -->
          <p class="foot-tm">
            Apple, the Apple logo and iPad are trademarks of Apple Inc., registered in the U.S.
            and other countries and regions. App Store is a service mark of Apple Inc. Google
            Play and the Google Play logo are trademarks of Google LLC. Open Audio Analyzer is
            not affiliated with, endorsed by or sponsored by either company.
          </p>

          <div class="foot-rule">
            <span class="num">© 2026 Jonas Grunau</span>
            <span class="num">open-audio-analyzer.com</span>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>

<style>
  /* The application draws its own chrome and its menu bar runs to the top
     edge of the window. The site's header is the same object: one hairline,
     no shadow, and it does not float above the page pretending to hover. */
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid var(--hair);
  }

  .bar-in {
    height: var(--s48);
    display: flex;
    align-items: center;
    gap: var(--s32);
  }

  .mark {
    display: flex;
    align-items: center;
    gap: var(--s8);
    flex: none;
  }

  .wordmark {
    font-size: 0.75rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 100;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  nav {
    display: flex;
    gap: var(--s24);
    margin-right: auto;
  }

  .navlink {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    transition: color 140ms linear;
  }

  .navlink:hover {
    color: var(--text);
  }

  /* The one thing in the bar that is an action rather than a signpost, so the
     one thing that is drawn as a button — in the same accent as the hero's, and
     to the same shape. */
  .bar-dl {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-inline: var(--s12);
    background: var(--signal);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 140ms linear;
  }

  .bar-dl:hover {
    filter: brightness(1.08);
  }

  .bar-end {
    display: flex;
    align-items: center;
    gap: var(--s16);
    flex: none;
  }

  .ver {
    font-size: 0.6875rem;
    color: var(--faint);
    border: 1px solid var(--hair);
    padding: 0 var(--s4);
  }

  /* --- footer --- */

  /* One line, for pages whose content is already the argument. */
  .foot-slim {
    padding-block: var(--s24);
  }

  .foot-slim-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s24);
    flex-wrap: wrap;
    font-size: 0.6875rem;
    color: var(--faint);
    letter-spacing: 0.04em;
  }

  /* The row wraps. The line above it does — `.foot-slim-in` has had
     `flex-wrap` since there was a slim footer — but this inner row did not, so
     the links stayed one unbreakable 381 px line and every page carrying this
     footer was 7 px wider than a 390 px phone and 37 px wider than a 360 px
     one. Small enough to look like nothing and site-wide, which is the worst
     combination: it is the same misalignment on every page, so it reads as the
     design rather than as a bug. */
  .foot-slim-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s24);
    row-gap: var(--s8);
  }

  .foot-slim-links .foot-a {
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .foot {
    border-top: 1px solid var(--hair);
    padding-block: var(--s64) var(--s32);
    background: var(--ink);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: var(--s48);
  }

  .foot-p {
    font-family: var(--prose);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--faint);
    max-width: 46ch;
  }

  .foot-a {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 140ms linear;
  }

  .foot-a:hover {
    color: var(--signal);
  }

  .foot-lic {
    font-size: 0.8125rem;
    color: var(--faint);
  }

  .foot-lic .num {
    color: var(--muted);
    font-size: 0.75rem;
  }

  /* The licence line is the only place in the footer where a link sits inside a
     run of prose rather than being the whole row, and `.link-quiet` separates
     itself from its surroundings by colour alone — `--muted` on `--faint`, which
     is 1.22:1 between them. Nobody reading with low vision, or on a screen in
     sunlight, can see a difference that small, so the link takes the hairline
     underline `.link` uses. The same rule and the same reason apply to the two
     links in the hero credit; see index.astro. */
  .foot-lic .link-quiet {
    border-bottom-color: var(--faint);
  }

  .foot-lic .link-quiet:hover {
    border-bottom-color: var(--signal);
  }

  /* Legal small print: the only text on the site set smaller than the footer
     rule, because it is a requirement to be met rather than a line to be read.
     It keeps a measure — a licence notice run the full 1440 px is four words
     per eye movement and nobody finishes it. */
  .foot-tm {
    margin-top: var(--s48);
    max-width: 96ch;
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--faint);
  }

  .foot-rule {
    margin-top: var(--s24);
    padding-top: var(--s16);
    border-top: 1px solid var(--hair);
    display: flex;
    justify-content: space-between;
    gap: var(--s16);
    font-size: 0.6875rem;
    color: var(--faint);
    letter-spacing: 0.04em;
  }

  @media (max-width: 1080px) {
    nav {
      display: none;
    }
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .wordmark {
      font-size: 0.6875rem;
    }
    .bar-in {
      gap: var(--s16);
    }
    /* The one thing in the bar that is an action rather than a signpost, so the
     one thing that is drawn as a button — in the same accent as the hero's, and
     to the same shape. */
  .bar-dl {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-inline: var(--s12);
    background: var(--signal);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 140ms linear;
  }

  .bar-dl:hover {
    filter: brightness(1.08);
  }

  .bar-end {
      margin-left: auto;
      gap: var(--s12);
    }
    .ver {
      display: none;
    }
    .foot-grid {
      grid-template-columns: 1fr;
      gap: var(--s32);
    }
  }
</style>
