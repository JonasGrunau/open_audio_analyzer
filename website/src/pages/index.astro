---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
/* Read from the application's own pubspec, so the version on the download
   button cannot be a release behind. See src/lib/app.mjs. */
import { REPO, RELEASES, VERSION, APP_STORE } from '../lib/app.mjs';
/* Written by `npm run analyzer` beside the still it describes, so the facade is
   sized from the picture that exists rather than from a number typed here. */
import still from '../data/analyzer-still.json';
/* Written by `npm run flow` beside the pictures it describes, the same way and
   for the same reason as the still above — and it is also the gate. A stage
   whose photograph has not been taken on this machine has no entry here and is
   simply not drawn, so the section is short rather than broken. See
   scripts/render-flow.mjs, which says what each one needs. */
import flowShots from '../data/flow-shots.json';

/* Whether `npm run analyzer` has been run.
   `public/analyzer/` is about 4 MB of compiled Flutter and is git-ignored — so
   a plain `npm run build` needs no Flutter toolchain, and `npm run deploy`
   builds it first. Checking here means a site built without it offers the still
   and no button, rather than a button onto a 404. */
/* Resolved from the project root rather than from `import.meta.url`, which
   during the build points at the compiled module and not at this file. */
const hasDemo = existsSync(join(process.cwd(), 'public/analyzer/index.html'));

const DOCS = '/docs';

/* The signal path: three programs, one stream of audio, and the same numbers in
   all three of them.

   This is the claim the rest of the page rests on — that the meters in a DAW,
   on the desktop and on a tablet are not three implementations that happen to
   agree, but one engine read from three places. It is stated in prose further
   down, under `#reach`; here it is shown, because a reader who has to be told
   that three sets of meters agree has already been given something to doubt.

   Every plate is a photograph of the real thing, taken by `npm run flow`.
   `website/AGENTS.md` is why: a tool that publishes real numbers beside
   invented pictures has no way to notice when the drawing and the meter drift
   apart, and that is the one failure a metering tool cannot ship. */
const FLOW = [
  [
    'plugin',
    'In your DAW',
    'The plugin measures',
    `Insert the <strong>VST3</strong> or the <strong>Audio Unit</strong> on your master bus. It
     draws no meters of its own: the panel says the link is live and that is all it does. What it
     measures goes to the app, along with where your playhead is.`,
    `The plugin's panel, linked. A diagram across the top shows the host on the left and the
     analyzer app on the right, both ends lit, with audio and playhead running into the plugin's
     mark and a dashed line carrying the measurements out the other side; the host reads receiving
     and the app reads linked. Below it the input is 48k and 2 channels, elapsed time is one hour
     two minutes, and integrated loudness is −14.3.`,
  ],
  [
    'desktop',
    'On the desktop',
    'The app draws it',
    `The canvas you arranged, every module on it reading the same instant of the same audio. It
     makes no difference whether that audio came from the plugin, from an input or from a file: the
     meters are the same meters.`,
    `The desktop canvas at one minute twenty-five into the track: six loudness readouts along the
     top, a LUFS meter and a loudness half-gauge both reading −13.7 LUFS integrated, per-channel
     peak bars, a delivery verdict reading NOT READY with one failure and two passes, a VU meter at
     +8.4, a loudness histogram against a −14 target line, a distribution, and a latched true-peak
     alert at −0.2 dBTP.`,
  ],
  [
    'tablet',
    'Across the room',
    'A tablet reads it too',
    `Press <strong>PUBLISH</strong> on the desktop and <strong>ATTACH</strong> on an iPad, and the
     tablet draws that canvas — the same application, the same modules, the same painters, over
     Wi-Fi. It is not measuring anything of its own: what is on it is the frame the desktop
     published. What you arranged on a 32-inch monitor opens on the tablet still looking arranged,
     not squashed.`,
    `The same application on an iPad in landscape, attached to that desktop over Wi-Fi: its bar
     names the host and the DAW's playhead, and below it stands the desktop's canvas, reading
     −13.7 LUFS integrated, 11.3 LU of range, −0.2 dBTP and +8.4 VU — every number the plate beside
     it is showing, at the same instant.`,
  ],
];

/* Only the stages whose photograph exists. Two of the three are committed; the
   tablet's needs an iPad simulator, so a machine without one builds a site that
   is complete and one plate shorter rather than a site with a hole in it. */
const flow = FLOW.filter(([id]) => flowShots[id]);

/* The catalogue. Every one of these is one ModuleFrame plus a painter in the
   application, reading the same MeterSource and repainting from the same
   clock — and every thumbnail is a photograph of the real thing, taken by
   `npm run modules`. See scripts/render-modules.mjs. */
// The fourteen modules, each with the photograph of it taken from the running
// application by `npm run modules`, and what the photograph shows. The images
// carry the app's own frame and title bar, because they *are* the app's frame
// and title bar — see scripts/render-modules.mjs.
const MODULES = [
  ['number-box', 'Number Box', 'Any single measurement, as a number.',
    'A Number Box reading −14.1 LUFS in green, on target.'],
  ['lufs-meter', 'LUFS Meter', 'Momentary, short-term and integrated loudness as three bars against a target band, each with its value beneath.',
    'A LUFS Meter: three bars named MOMENTARY, SHORT and INTEGRATED against a dashed target line, each with its reading printed beneath it.'],
  ['super-meter', 'Super Meter', 'Loudness from the left and Open Dynamic Range continuing from its tip to the true peak, on one half-gauge; LUFS, ODR and true peak in the centre.',
    'A Super Meter: a half-gauge with teal loudness arcs filling from the left and thinner Open Dynamic Range arcs continuing from their tips to grey true-peak ticks, LUFS-S and ODR-S riding the outer tips, a red target tick, and LUFS, ODR and true peak readouts in the centre.'],
  ['digital-meter', 'Digital Meter', 'Sample peak and RMS, per channel, up to 7.1 — as segmented bars and as numbers.',
    'A Digital Meter: left and right bars with peak-hold lines held near the top of the scale.'],
  ['vu-meter', 'VU Meter', 'A needle, with the ballistics of the real thing.',
    'A VU Meter reading −7.0 VU: a needle under a banded scale that turns red above 0 VU, with the peak mark left standing near the top of it.'],
  ['alert-meter', 'Alert Meter', 'One measurement, watched, with the worst it has been latched — the reading itself, or its distance from the target.',
    'An Alert Meter in red, showing true peak at −0.2 dBTP with −0.2 latched as the worst so far.'],
  ['validator', 'Validator', 'The delivery decision, as a table.',
    'A Validator reading NOT READY: loudness and range pass, true peak fails at −0.2 against a −1.0 ceiling.'],
  ['histogram', 'Histogram', 'Loudness against time: how the programme moved, and when it was over target.',
    'A Histogram: thirty seconds of short-term loudness against a dashed target line, with a dip where the programme breaks.'],
  ['loudness-distribution', 'Loudness Distribution', 'How much of the programme was spent at each loudness.',
    'A Loudness Distribution: a peak near −14 LUFS with the 7.9 LU range bracketed across it.'],
  ['spectrum-analyzer', 'Spectrum Analyzer', 'Level against frequency, log-spaced, with a peak hold.',
    'A Spectrum Analyzer: a bass-heavy curve falling away above 10 kHz, with a peak-hold line over it.'],
  ['spectrogram', 'Spectrogram', 'Frequency against time, with level as colour.',
    'A Spectrogram: frequency against time, with sustained tones as horizontal bands and transients as vertical ones.'],
  ['oscilloscope', 'Oscilloscope', 'The waveform itself, one lane per channel or both overlaid.',
    'An Oscilloscope showing 20 milliseconds of waveform in two lanes, left above right.'],
  ['phase-scope', 'Phase Scope', 'A goniometer: left against right, rotated so mono stands upright.',
    'A Phase Scope: an upright figure leaning slightly, drawn from left against right inside a lettered square frame, with balance and correlation markers on its edges.'],
  ['stereo-cloud', 'Stereo Cloud', 'Where each frequency sits in the stereo image over the last two seconds, one mark per band per frame.',
    'A Stereo Cloud: frequency up the side, stereo position across, a field of diamonds brighter where the band is louder, bass gathered at the centre and the top spread wide.'],
];

const METRICS = [
  [
    'Loudness',
    'LUFS, weighted the way <strong>ITU-R BS.1770-4</strong> says: low end counts for less, presence for more, so the meter agrees with your ears about what is loud instead of counting energy. Worked out at your material’s own sample rate, not at 48 kHz and hoped.',
  ],
  [
    'Integrated',
    'The whole programme as one number, gated to <strong>EBU R 128</strong>: passages far below the rest are left out, so the silence between phrases and the fade at the top do not drag it below what the track sounds like.',
  ],
  ['Momentary / Short-term', '400 milliseconds and 3 seconds. One is what a transient does to your loudness; the other is what a section does.'],
  [
    'LRA',
    'Loudness range: how far the loud parts of the programme sit above the quiet ones. It is the number a broadcaster asks for, and the one that says whether a master has been flattened.',
  ],
  [
    'True peak',
    'The peak <em>between</em> samples as well as on them, oversampled four times as <strong>BS.1770-4</strong> requires. It is the number a delivery ceiling means, and it sits above the sample peak your DAW shows — by as much as a dB and a half on heavily limited material.',
  ],
  [
    'Open Dynamic Range',
    'True peak minus loudness over the same audio: <strong>ODR-S</strong> over the last three seconds, <strong>ODR-I</strong> over the whole programme. How hard the limiter is working, in a number that does not move when a platform turns the track down. Defined in the <a class="link" href="/docs/odr">ODR specification</a>.',
  ],
  [
    'Spectrum',
    '512 bands, spaced the way you hear rather than the way the arithmetic falls out. Each band shows the loudest thing in it rather than the average, so a narrow resonance stands at its real height instead of being smoothed into the noise beside it.',
  ],
  ['Correlation', 'How alike the two channels are: +1 is mono, 0 is uncorrelated, −1 is one channel inverted against the other.'],
  [
    'Crest',
    'Peak minus RMS: how much room the transients have above the body of the sound. A sine is 3.01 dB, a snare is a lot more, and a master that has been squeezed trends towards nothing.',
  ],
  [
    'Clip',
    'The longest run of samples pinned at full scale since you last reset, per channel. It stays on screen, so a clip three samples long is still there when you come back to look for it.',
  ],
];

const PLATFORMS = [
  ['macOS 14.2+', 'Universal — Apple silicon and Intel', '.pkg', 'VST3 + AU'],
  ['Windows 10 1809+', 'Uninstaller in Installed apps', '.exe', 'VST3'],
  ['Linux', 'install.sh, no root', '.tar.gz', 'VST3'],
  ['Linux', 'One file, no root, GTK from the host', '.AppImage', '—'],
  ['Linux', 'Sandboxed, carries its own runtime', '.flatpak', '—'],
  ['Any', 'The file analyser, for a terminal', 'oaa CLI', '—'],
];

/* Annex A.2 of the ODR specification, informative, restated here so the
   reader gets the sense of scale without a click — and to scale: each band is
   drawn as wide as it is long in LU. `README.md`'s ODR section carries the
   same table; a change to the annex is a change to both. The anchors are
   arithmetic on published delivery levels (target + ODR-I is where the peaks
   land after normalisation); the names are editorial and say so. */
const BANDS = [
  { lu: 5, range: '0 – 5', name: 'Flat', note: 'The limiter’s ceiling is the loudness.' },
  { lu: 3, range: '5 – 8', name: 'Crushed', note: 'The late loudness war.' },
  { lu: 2, range: '8 – 10', name: 'Loud', note: '' },
  { lu: 3, range: '10 – 13', name: 'Balanced', note: 'Nothing is lost at −14 LUFS.', line: true },
  { lu: 3, range: '13 – 16', name: 'Dynamic', note: 'Plays below target on −14 platforms, transients intact.' },
  { lu: 8, range: 'over 16', name: 'Wide', note: 'Ordinary for classical, jazz, film and broadcast.' },
];
const BAND_SCALE = BANDS.reduce((sum, b) => sum + b.lu, 0);
const ANCHORS = [
  { lu: 0, label: '0.0', what: 'a full-scale stereo sine' },
  { lu: 5.9, label: '5.9', what: '−6 LUFS at −0.1 dBTP' },
  { lu: 8.7, label: '8.7', what: '−9 LUFS at −0.3 dBTP, a loud CD' },
  { lu: 13, label: '13.0', what: '−14 LUFS at −1 dBTP, the streaming line', line: true },
  { lu: 15, label: '15.0', what: '−16 LUFS at −1 dBTP' },
  { lu: 22, label: '22.0', what: '−23 LUFS at −1 dBTP, EBU R 128' },
];
---

<Base
  title="Open Audio Analyzer — free and open-source loudness and spectrum analyzer"
  description="A free and open-source loudness and spectrum analyzer. Fourteen meters on a canvas you arrange, measuring LUFS and true peak to EBU R128 — desktop, DAW, tablet."
  path="/"
>
  <!-- ===================== hero ===================== -->
  <!--
    The first screen is the instrument, not a description of it.

    It was a column of prose beside a five-row table of platforms and licences.
    The table was the problem: everything on it is true, none of it is what
    somebody wants in the first ten seconds, and it is all stated properly in
    the download section further down — where a table with four columns can
    actually say which installer carries the plugin. It has become one line,
    and the space it held is now the thing this project makes.

    The live analyzer used to be a section of its own under a heading. It is
    here instead, so that the page opens on a canvas of working meters with the
    real one a press away, and so that the reader passes one screen to reach it
    rather than three.
  -->
  <section class="hero shell" id="analyzer">
    <p class="eyebrow num">
      <a class="link-quiet" href={REPO} rel="noopener">github.com/JonasGrunau/open_audio_analyzer</a>
    </p>

    <h1>Open Audio Analyzer</h1>

    <div class="hero-lede">
      <p class="prose hero-deck">
        A free and open-source loudness and spectrum analyzer. Fourteen meter modules on a canvas
        you arrange — on the desktop, inside your DAW, and on a tablet beside the desk.
      </p>
    </div>

    <!--
      The button row sits outside `.hero-lede` on purpose. That box is
      `max-width: 62ch`, which is the measure the deck is set to and the reason
      the sentence above reads as a statement; a row of controls is not prose
      and inherited nothing from it but a wrap. Three buttons and two store
      badges are about 850 px, so inside the measure the badges fell to a second
      line at every window width there is.

      Apple's badge is first because Apple's guidelines say it is — "Place the
      App Store badge first in the lineup of badges" — and Google's ask only
      that theirs be "the same size or larger than the other badges", which
      equal height satisfies. Both artworks are used exactly as their owners
      publish them: the black badge with its grey border, no recolouring, no
      hover transform, and nothing typeset inside the quarter-of-a-badge-height
      of clear space each of them requires. That is what `--s12` under a 48 px
      badge is measuring out, and it is why the captions are a gap rather than
      an overlay.

      The Play badge points at `/testing`, not at Play. Both of the URLs Play
      offers for a closed test turn away everybody who is not already on the
      tester list, and neither says why — so the badge would recruit nobody.
      Google's badge guidelines constrain the artwork and say nothing about the
      destination, which was checked; Apple's do constrain it, which is one more
      reason their badge is not a link here.
    -->
    <div class="cta">
      <a class="btn btn-primary" href={RELEASES} rel="noopener">Download {VERSION}</a>
      <a class="btn" href={REPO} rel="noopener">Source</a>
      <a class="btn" href={DOCS}>Documentation</a>

      <div class="stores">
        <div class="store">
          {APP_STORE ? (
            <a class="store-badge" href={APP_STORE} rel="noopener">
              <img
                class="store-art"
                src="/badges/app-store.svg"
                alt="Download on the App Store"
                width="144"
                height="48"
                decoding="async"
              />
            </a>
          ) : (
            <span class="store-badge">
              <img
                class="store-art"
                src="/badges/app-store.svg"
                alt="Download on the App Store"
                width="144"
                height="48"
                decoding="async"
              />
            </span>
          )}
        </div>

        <div class="store">
          <a class="store-badge" href="/testing">
            <img
              class="store-art"
              src="/badges/google-play.svg"
              alt="Get it on Google Play"
              width="162"
              height="48"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- What the plate said, in the space of a line. Anything a reader has to
         act on — which installer carries the plugin, what each one will not
         do — is in the download section, which has room to say it. -->
    <p class="hero-meta">
      <span class="num">macOS · Windows · Linux · iPadOS · Android</span>
      <span class="hero-sep" aria-hidden="true">/</span>
      <span class="num">VST3 · Audio Unit · CLI</span>
      <span class="hero-sep" aria-hidden="true">/</span>
      <span class="num">Free, GPL-3.0</span>
    </p>

    <figure class="facade" data-facade>
      {/* The one picture on the page that is fetched before anything is
          scrolled, so the one whose size decides Largest Contentful Paint.

          `sizes` is not a guess — it is `.shell` written out. That box is
          `min(100vw, 1440px)` wide less a gutter of 32 px, or 24 below 900 px,
          or 16 below 560, and those three breakpoints are in global.css. Get it
          wrong in the optimistic direction and every phone downloads the
          desktop file while the browser reports no problem at all; the widths
          themselves are listed in scripts/render-analyzer.mjs, which writes
          them. */}
      <img
        src="/analyzer-still.webp"
        srcset={still.sources.map((source) => `${source.file} ${source.width}w`).join(', ')}
        sizes="(min-width: 1440px) 1376px, (min-width: 901px) calc(100vw - 64px), (min-width: 561px) calc(100vw - 48px), calc(100vw - 32px)"
        alt="Eight meter modules on one canvas: loudness bars, a loudness half-gauge, a spectrum analyser, a minute of loudness against time, a delivery verdict reading NOT READY, per-channel peak bars, a waveform and a latched true-peak alert."
        width={still.width}
        height={still.height}
        fetchpriority="high"
        decoding="async"
      />
      {
        hasDemo && (
          <>
            {/* Three elements where one glyph would do, because each carries a
                transform of its own once the control is pressed: the mark
                travels to the middle of the picture, the ring inside it turns
                into a spinner and rotates, and the triangle fades out from
                under both. One element can only carry one transform. */}
            <button class="facade-go" type="button" data-facade-go>
              <span class="facade-go-mark" aria-hidden="true" data-facade-mark>
                <span class="facade-go-ring" />
                {/* Drawn, not typed. U+25B6 BLACK RIGHT-POINTING TRIANGLE is on
                    the emoji tables with a *text* default presentation, which a
                    desktop honours and a phone does not: iOS and Android both
                    resolve it out of the colour emoji font, so the hairline
                    square came out holding a rounded, oversized emoji play
                    button. A path has no font behind it to be substituted. */}
                <svg class="facade-go-tri" viewBox="0 0 10 12" aria-hidden="true">
                  <path d="M0 0 L10 6 L0 12 Z" />
                </svg>
              </span>
              <span class="facade-go-text" data-facade-text>
                <span data-facade-label>Load the live analyzer</span>
                <span class="facade-go-sub">Real meters, running in your browser</span>
              </span>
            </button>
            {/* The spinner says nothing to a screen reader, and the label it
                replaces is on its way off the picture. This is what announces
                the wait, and the end of it. */}
            <p class="visually-hidden" role="status" data-facade-status />
          </>
        )
      }
    </figure>

    <!-- Required, not decorative. The programme behind those meters is a CC BY
         3.0 track, and that licence asks for credit wherever the audio is
         published — which a page that plays it is. The wording and the link are
         copied from test_audio/ATTRIBUTION.md, written by the tool that fetched
         it, so there is one place this is stated from.

         It is not drawn on a phone, where the control that loads the analyzer is
         not drawn either: with nothing to press, the audio is never fetched and
         never played, and what is left on the page is a photograph of meter
         readings. Those are measurements of the track, not the track. The two go
         together and must keep going together — a phone that can start the
         analyzer is a phone that has to carry this line. See the media query in
         the stylesheet. -->
    <p class="hero-credit">
      Measured from <em>Apathy And Resignation Are The Sources Of Our Misfortune</em> by
      <a class="link-quiet" href="https://citizensoftheempire.bandcamp.com/" rel="noopener">Citizens
      Of The Empire</a>, <a class="link-quiet" href="https://creativecommons.org/licenses/by/3.0" rel="noopener">CC
      BY 3.0</a>. The readings are the engine's own, recorded from that track — not a simulation.
    </p>

  </section>

  <!-- ===================== the signal path ===================== -->
  <section class="section shell" id="workflow">
    <div class="section-head">
      <div>
        <p class="label">How it works</p>
        <h2 class="section-title">Insert one plugin,<br />read it across the room</h2>
      </div>
    </div>

    <p class="prose">
      Insert the plugin on your master bus and open the app on the desktop beside you: that is the
      setup. If you would rather read the meters from where you are standing than from where the
      computer is, a tablet across the room attaches to the same session and draws them too. You are
      not routing audio anywhere or matching one meter against another.
    </p>

    <p class="prose flow-intro">
      Nothing along this path measures anything twice. The plugin takes the readings, the desktop
      draws them, and the tablet across the room draws the same ones — one engine, one set of
      numbers, three places to read them. So the meter you glance at from the far side of the studio
      cannot quietly disagree with the one under your hand. The two photographs below are that
      claim rather than an illustration of it: they were taken from one frozen frame of one
      session, with the tablet attached to the desktop beside it, which is why every reading in
      them is the same reading.
    </p>

    <ol class="flow" style={`--flow-n: ${flow.length}`}>
      {
        flow.map(([id, where, name, body, alt], i) => (
          <li class="flow-step">
            <p class="flow-mark">
              <span class="flow-n num">{String(i + 1).padStart(2, '0')}</span>
              <span class="flow-where">{where}</span>
            </p>
            {/* The tablet is the one plate that is a picture of an object rather
                than a picture of a screen, so it is the one that gets a bezel.
                See the note on the radius in the stylesheet. */}
            <figure class={id === 'tablet' ? 'flow-plate flow-device' : 'flow-plate'}>
              <img
                src={`/flow/${id}.webp`}
                alt={alt}
                width={flowShots[id].width}
                height={flowShots[id].height}
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1081px) 30vw, (min-width: 561px) calc(100vw - 48px), calc(100vw - 32px)"
              />
            </figure>
            <h3 class="flow-name">{name}</h3>
            <p class="prose flow-body" set:html={body} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section shell" id="modules">
    <div class="section-head">
      <div>
        <p class="label">Modules</p>
        <h2 class="section-title">Fourteen meter modules</h2>
      </div>
    </div>

    <p class="prose mod-intro">
      You choose which of them are on screen. Drag a meter onto the canvas, size it, put it where
      you want it: loudness and a delivery verdict when you are finishing a master, a spectrum and a
      phase scope while you mix, a VU and a waveform while you track. The arrangement you settle on
      saves as a preset, for the desktop and for the tablet beside it.
    </p>

    <ul class="cat">
      {
        MODULES.map(([shot, name, desc, alt]) => (
          <li class="cat-item">
            <div class="cat-shot">
              <img
                src={`/modules/${shot}.webp`}
                alt={alt}
                width="390"
                height="256"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="cat-name">{name}</h3>
            <p class="cat-desc">{desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== measurement ===================== -->
  <section class="section shell" id="measurement">
    <div class="section-head">
      <div>
        <p class="label">Measurement</p>
        <h2 class="section-title">Every number, and what<br />it actually means</h2>
      </div>
    </div>

    <div class="split">
      <div class="table-scroll" tabindex="0" role="region" aria-label="Measurement definitions">
      <table class="spec">
        <thead>
          <tr>
            <th scope="col">Reading</th>
            <th scope="col">What it is</th>
          </tr>
        </thead>
        <tbody>
          {
            METRICS.map(([q, d]) => (
              <tr>
                <td class="q">{q}</td>
                <td set:html={d} />
              </tr>
            ))
          }
        </tbody>
      </table>
      </div>

      <aside class="gate module">
        <div class="module-bar">
          <span class="name">Checked against the reference cases</span>
        </div>
        <div class="gate-body">
          <ul class="gate-list">
            <li>
              <span class="gate-k">EBU Tech 3341 — loudness</span>
              <span class="gate-v sig">PASS</span>
            </li>
            <li>
              <span class="gate-k">EBU Tech 3342 — loudness range</span>
              <span class="gate-v sig">PASS</span>
            </li>
            <li>
              <span class="gate-k">ODR 1.0 § 7 — dynamics</span>
              <span class="gate-v sig">PASS</span>
            </li>
            <li>
              <span class="gate-k">A full-scale tone reads</span>
              <span class="gate-v sig">0.0 dBFS</span>
            </li>
            <li>
              <span class="gate-k">44.1 / 48 / 88.2 / 96 / 192 kHz</span>
              <span class="gate-v sig">AGREE</span>
            </li>
            <li>
              <span class="gate-k">The same track, live and from a file</span>
              <span class="gate-v sig">IDENTICAL</span>
            </li>
          </ul>
          <p class="gate-note">
            Every change to the meters is held against these before it ships, and against the full
            EBU and ITU vector sets on top of them. The dynamics readings have no reference cases
            from anyone else, so the <a class="link" href="/docs/odr">ODR specification</a> carries
            its own: seven generated signals with stated tolerances, run the same way.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ===================== honesty ===================== -->
  <section class="section shell honesty">
    <div class="section-head">
      <div>
        <p class="label">Dynamics</p>
        <h2 class="section-title">Open Dynamic Range,<br />defined to the operand</h2>
      </div>
    </div>

    <div class="dyn">
      <div class="stack-24">
        <p class="prose">
          There is no standard that says what “dynamic range” is, so Open Audio Analyzer publishes
          one. <strong>ODR-S</strong> is the true peak of the last three seconds against the
          short-term loudness of the same three seconds: how much room the loudest moment of a
          passage has over how loud that passage is. <strong>ODR-I</strong> is the same question
          about the whole programme — the highest true peak against the integrated loudness. Watch
          either one fall as you push a limiter and you are watching the squeeze happen.
        </p>
        <p class="prose">
          The arithmetic is the AES peak-to-loudness ratio. What the specification adds is every
          choice that note leaves open: true peak and never sample peak, both operands over the same
          window, undefined in silence rather than reading zero, the most squeezed three seconds
          reported beside the whole. It is held in CI against arithmetic — a stereo sine reads
          exactly 0.0 LU on both — and a delivery target can put a floor under either, so a master
          limited past it fails the same way one over its peak ceiling does.
        </p>
        <p>
          <a class="link" href={`${DOCS}/odr`}>Read the ODR specification</a>
        </p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Open Dynamic Range definitions">
        <table class="spec">
          <thead>
            <tr>
              <th scope="col">Reading</th>
              <th scope="col">Is</th>
              <th scope="col">Undefined while</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="q">ODR-S</td>
              <td><code>TP(3 s) − LUFS-S</code>, the last three seconds</td>
              <td>LUFS-S is at or below the −70 LUFS absolute gate</td>
            </tr>
            <tr>
              <td class="q">ODR-I</td>
              <td><code>TP Max − LUFS-I</code>, the programme since reset</td>
              <td>LUFS-I is undefined</td>
            </tr>
            <tr>
              <td class="q">min ODR-S</td>
              <td>The lowest ODR-S the programme reached, where it was defined</td>
              <td>ODR-S has never been defined</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="bands" style={`--scale: ${BAND_SCALE}`}>
      <div class="stack-24">
        <p class="label">Reading the number</p>
        <p class="prose bands-lead">
          Normalise a master to a target and its true peak lands at the target plus its ODR-I — so
          under −14 LUFS and a −1 dBTP ceiling, <strong>13 LU</strong> is the most a platform can
          play at its own level. The bands are the specification’s Annex A: the anchors are
          arithmetic on published delivery levels, the names are editorial, and 7 LU is a choice in
          a techno track and a casualty in a string quartet.
        </p>
      </div>
      <div class="band-scale" aria-hidden="true">
        {ANCHORS.map((a) => (
          <span class:list={['band-tick', { 'band-tick-line': a.line }]} style={`--at: ${a.lu}`}>
            {a.label}
          </span>
        ))}
      </div>
      <ol
        class="band-strip"
        style={`--cols: ${BANDS.map((b) => `minmax(0, ${b.lu}fr)`).join(' ')}`}
        aria-label="What an ODR-I reading means, from flat to wide"
      >
        {BANDS.map((b) => (
          <li class:list={['band', { 'band-line': b.line }]}>
            <span class="band-range">{b.range} LU</span>
            <span class="band-name">{b.name}</span>
            {b.note && <span class="band-note">{b.note}</span>}
          </li>
        ))}
      </ol>
      <ul class="band-legend" aria-label="Where the anchors come from">
        {ANCHORS.map((a) => (
          <li class:list={{ 'band-legend-line': a.line }}>
            <span class="band-legend-n">{a.label}</span>
            {a.what}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== reach ===================== -->
  <section class="section shell" id="reach">
    <div class="section-head">
      <div>
        <p class="label">Plugin, tablet and CLI</p>
        <h2 class="section-title">The same engine,<br />in three more places</h2>
      </div>
    </div>

    <div class="reach">
      <article class="stack-16">
        <h3>In a DAW</h3>
        <p class="prose reach-p">
          A <strong>VST3</strong> and an <strong>Audio Unit</strong>, on a track, a bus or the
          master. What you read while mixing is not a second set of meters built to look like the
          first — it is the first, watching your session.
        </p>
      </article>

      <article class="stack-16">
        <h3>On a tablet</h3>
        <p class="prose reach-p">
          It finds the desktop by itself, or reads a pairing code off its screen with the camera, or
          takes an address you type — three ways in, because the first one is what a venue’s Wi-Fi
          blocks. Publishing stays off until you switch it on, and there is no password on the link:
          <strong>switch it on at home, not on a network you do not control.</strong>
        </p>
      </article>

      <article class="stack-16">
        <h3>On the command line</h3>
        <p class="prose reach-p">
          <code>oaa</code> measures a file without opening anything — one track, or every file in an
          album folder in one go — and prints a report you can read or a CSV for a spreadsheet. It is
          the <em>same</em> analysis the app runs on live audio, down to the last decimal, with
          nothing resampled or remixed on the way in.
        </p>
      </article>
    </div>

    <div class="term module">
      <div class="module-bar">
        <span class="name">oaa — the command-line analyser</span>
      </div>
      <pre class="term-body"><code><span class="c">$</span> oaa master.wav                              <span class="cm"># the whole report, readable</span>
<span class="c">$</span> oaa --target streaming-14 master.wav        <span class="cm"># …and does it pass?</span>
<span class="c">$</span> oaa --target streaming-14 album/*.wav       <span class="cm"># the whole album, one pass each</span>
<span class="c">$</span> oaa --format csv -o loudness.csv master.wav  <span class="cm"># loudness over time, for a spreadsheet</span>
<span class="c">$</span> oaa --list-targets                          <span class="cm"># what you can measure against</span></code></pre>
    </div>
  </section>

  <!-- ===================== configuration ===================== -->
  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="label">Configuration</p>
        <h2 class="section-title">Settings, presets, targets<br />and skins</h2>
      </div>
    </div>

    <div class="cfg">
      <div class="stack-24">
        <p class="prose">
          Save an arrangement of meters as a preset and it opens that way next time: the same modules
          in the same places, on a 32-inch monitor or on the tablet beside it. Presets, delivery
          targets and colour schemes are small text files in a folder you can open, so your setup
          travels to the studio machine, or to somebody who works the way you do.
        </p>
        <p class="prose">
          A <strong>delivery target</strong> is the numbers you have to hit: a loudness, how far
          either side of it you may land, a true-peak ceiling, and a limit on how much the loudness
          may move across the track. The streaming and broadcast ones come with the app. If your
          label, your client or your own ears say otherwise, write your own — give it the name of one
          that ships and yours takes over everywhere, including the pass or fail the command-line
          analyser reports, and deleting your file brings the original back.
        </p>
        <p class="prose">
          Colour works the same way. Thirteen things on screen have a colour of their own — the
          meter track, the readout, the colour that means <em>over the limit</em> — and there is a
          picker for each: the canvas repaints while you drag, and any tablet mirroring the session
          repaints with it. Each colour tells you how well it reads against the panel behind it, so
          you find out that your meter track is nearly invisible before you are on a dark stage
          looking for it.
        </p>
      </div>

      <div class="json module">
        <div class="module-bar">
          <span class="name">calibrations/house-standard.json</span>
        </div>
        <pre class="json-body"><code>&lbrace;
  <span class="k">"id"</span>: <span class="s">"house-standard"</span>,
  <span class="k">"name"</span>: <span class="s">"House standard"</span>,
  <span class="k">"lufs_target"</span>: <span class="n">-12.0</span>,
  <span class="k">"lufs_tolerance"</span>: <span class="n">0.5</span>,
  <span class="k">"true_peak_max"</span>: <span class="n">-1.0</span>,
  <span class="k">"lra_max"</span>: <span class="n">14.0</span>,
  <span class="k">"odr_i_min"</span>: <span class="n">8.0</span>,
  <span class="k">"odr_s_min"</span>: <span class="n">6.0</span>,
  <span class="k">"vu_reference"</span>: <span class="n">-18.0</span>
&rbrace;</code></pre>
      </div>
    </div>
  </section>

  <!-- ===================== download ===================== -->
  <section class="section shell" id="get">
    <div class="section-head">
      <div>
        <p class="label">Installing</p>
        <h2 class="section-title">What to download,<br />per platform</h2>
      </div>
    </div>

    <div class="dl">
      <div class="table-scroll" tabindex="0" role="region" aria-label="Download artefacts">
      <table class="spec">
        <thead>
          <tr>
            <th scope="col">Platform</th>
            <th scope="col">Download</th>
            <th scope="col">Plugin</th>
            <th scope="col">Note</th>
          </tr>
        </thead>
        <tbody>
          {
            PLATFORMS.map(([plat, note, art, plug]) => (
              <tr>
                <td class="q">{plat}</td>
                <td><code>{art}</code></td>
                <td class="num dl-plug">{plug}</td>
                <td>{note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      </div>

      <div class="cta">
        <a class="btn btn-primary" href={RELEASES} rel="noopener">Download {VERSION}</a>
        <a class="btn" href={`${REPO}/releases`} rel="noopener">Release notes</a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/facade.js';
  </script>
</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    padding-block: var(--s48) var(--s96);
  }

  .eyebrow {
    font-size: 0.8125rem;
    color: var(--faint);
  }

  h1 {
    margin-top: var(--s24);
  }

  /* One column, and narrow. The deck is the only prose on this screen, and a
     sentence set the width of a 1440 px page is a sentence nobody finishes —
     the measure is what makes it read as a statement rather than a paragraph. */
  .hero-lede {
    margin-top: var(--s32);
    max-width: 62ch;
  }

  .hero-deck {
    font-size: clamp(1.1875rem, 1.5vw, 1.4375rem);
    line-height: 1.5;
    color: var(--text);
    max-width: none;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    /* The badges are taller than the buttons, because each one carries a caption
       under it. `flex-start` is what keeps the two badge artworks on the same
       baseline as the three buttons and lets the captions hang into the space
       below, which was empty anyway. `center` would push the buttons down by
       half a caption and align nothing to anything. */
    align-items: flex-start;
    gap: var(--s12);
    margin-top: var(--s32);
  }

  /* ---------- the two app store badges ----------
     Vendor artwork. The CSS here only ever positions it, with **one deliberate
     exception** recorded below: no recolouring, no filter, no transform, no
     hover state and no animation on `.store-art`, because Google's guidelines
     forbid altering the badge and Apple's forbid animating it as well.

     The exception is the dimming of the App Store badge while there is no iPad
     app to download, which is a departure from Apple's "Don't modify … the App
     Store badge" made knowingly and at the maintainer's instruction. It is
     scoped as tightly as it can be — see `span.store-badge` — so it applies to
     the pending badge and to nothing else, and it disappears by itself the day
     `APP_STORE` gets a URL. Do not widen it, and do not take it as licence to
     restyle the live badge. */
  .stores {
    display: flex;
    flex-wrap: wrap;
    /* Google asks for one quarter of the badge height as clear space, which is
       12 px under a 48 px badge; Apple asks for the same quarter. `--s16`
       between the two badges clears both with room to spare. */
    gap: var(--s16);
    /* The hairline is the seam between what this project publishes and what a
       store does. It is drawn on the left of the group rather than as an
       element of its own so that it wraps with the badges instead of stranding
       itself at the end of the button row. */
    position: relative;
    margin-left: var(--s12);
    padding-left: var(--s24);
  }

  .stores::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    /* The button height, not the group's: the seam belongs to the row the
       badges are in line with, and running it down past the captions would make
       it the tallest mark on the screen. */
    height: var(--s48);
    background: var(--hair-strong);
  }

  .store {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* The clear space itself. Both guidelines say no typography inside a
       quarter of the badge height, and this is that quarter measured out. */
    gap: var(--s12);
  }

  /* The link is the badge and only the badge. The caption below is a subline
     about the badge, not a second half of it, so it sits outside the anchor —
     otherwise the click target is an L-shape that reaches down into the clear
     space, and the caption reads as a label the artwork is missing. */
  .store-badge {
    display: block;
  }

  .store-art {
    display: block;
    height: var(--s48);
    /* Width follows the artwork's own aspect ratio. Never a fixed width — both
       guidelines forbid stretching the badge, and the two of them are not the
       same shape: 3.37:1 for Google Play against 2.99:1 for the App Store. */
    width: auto;
  }

  /* The badge that is not a link yet, greyed so the pending state is visible
     rather than only readable. A `<span>` rather than an `<a>` is exactly the
     condition — `index.astro` renders the anchor the moment `APP_STORE` is set
     — so there is no class to remember to remove and no way for this to outlive
     the thing it describes.

     Opacity rather than a filter: the badge is already monochrome, so
     `grayscale()` would do nothing, and blending it toward the page background
     is what "not yet" looks like on a dark ground. It is the only thing that
     says so now — the caption that used to spell it out is gone — which is why
     it stays.

     See the block header for why this one property is here at all. */
  span.store-badge .store-art {
    opacity: 0.42;
  }

  /* Keyboard focus lands on the badge, so it has to be visible there. An
     outline is drawn outside the element and disappears with the focus, which
     is why it is the one mark allowed to cross into the clear space — the
     alternative is a link nobody navigating by keyboard can find. */
  a.store-badge:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: var(--s4);
  }

  /* Where the five-row plate went: platforms, what it loads into, what it
     costs — as one readout line, in the meter face and at the size a module
     draws its own readout, because that is what it is. */
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s12);
    margin-top: var(--s32);
    font-size: 0.75rem;
    color: var(--faint);
    letter-spacing: 0.01em;
  }

  .hero-sep {
    color: var(--hair-strong);
  }

  /* Under the canvas, quiet, and never removed: see the note in the markup. */
  .hero-credit {
    margin-top: var(--s16);
    max-width: 78ch;
    font-family: var(--prose);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--faint);
  }

  .hero-credit em {
    font-style: italic;
  }

  /* The two links in the credit are the only ones on the site that sit *inside*
     a run of prose, and `.link-quiet` distinguishes itself from the text around
     it by colour alone — `--muted` against `--faint`, which is 1.2:1 between
     them. Colour at that distance is not a difference a reader with low vision
     or a monochrome display can see, so the link needs a second cue: the same
     hairline underline `.link` carries. Everywhere else `.link-quiet` is a whole
     paragraph or a whole cell, where there is no surrounding text to be
     confused with, and it stays bare. */
  .hero-credit .link-quiet {
    border-bottom-color: var(--faint);
  }

  .hero-credit .link-quiet:hover {
    border-bottom-color: var(--signal);
  }

  /* ---------- the live analyzer in the hero, behind a facade ---------- */

  /* A photograph of the real canvas, with the real thing one press away.
     The aspect ratio is the still's own, declared so that nothing moves when
     the image arrives or when the iframe replaces it. */
  /* No aspect-ratio here: the still is in normal flow and its own width and
     height attributes give the box its shape, so a re-shot still of a different
     size cannot leave a strip of background down one edge. The iframe is laid
     over it. */
  .facade {
    position: relative;
    margin: var(--s32) 0 0;
    background: var(--ink);
    border: 1px solid var(--hair);
    overflow: hidden;
    line-height: 0;
  }

  .facade img {
    width: 100%;
    height: auto;
  }

  .facade img,
  .facade iframe {
    display: block;
    border: 0;
  }

  /* Sits over the still rather than beside it, because the still is the button:
     the thing you press is a picture of what you get. */
  .facade-go {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s12);
    width: 100%;
    background: color-mix(in srgb, var(--ink) 38%, transparent);
    border: 0;
    color: var(--text);
    font-family: var(--display);
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background 120ms linear,
      opacity 320ms ease;
  }

  /* `:hover` still matches a disabled button, and the control disables itself
     the moment it is pressed — so the resting brightening has to be gated, or
     the panel changes tone under a pointer that is only resting on a spinner.
     Gating it alone left the other half of that undone: the press disabled the
     button, `:hover` stopped matching, and the scrim dropped back to its
     resting tone — so the picture went *darker* in answer to being pressed,
     stayed there for the whole load, and lightened only when the frame
     arrived and the control went. Loading holds the tone the pointer gave it,
     written in the same rule so the two cannot drift apart.

     `aria-busy` rather than `.is-loading`, because the reduced-motion path
     sets the first and never the second: it swaps the label for words instead
     of running the spinner, and it is loading just the same. It is set at the
     press and removed in the same breath as `.is-done`, which fades the whole
     control out — so it is exactly the interval this is about, including the
     30-second deadline and the cross-origin bail-out. */
  .facade-go:not(:disabled):hover,
  .facade-go:not(:disabled):focus-visible,
  .facade-go[aria-busy='true'] {
    background: color-mix(in srgb, var(--ink) 22%, transparent);
  }

  .facade-go:disabled {
    cursor: default;
  }

  /* The mark holds the position and travels; the ring holds the shape and
     spins; the triangle is what goes. Stacked above the label so that the
     label passes behind it rather than through it. */
  .facade-go-mark {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
  }

  .facade-go-ring {
    position: absolute;
    inset: 0;
    border: 1px solid var(--signal);
    border-radius: 0;
    /* The fill is the surface the label goes behind: a hairline outline hides
       nothing, and the last few pixels of a letter are under the disc before
       the cut reaches them. */
    background: transparent;
    /* All three land together at 200 ms, which is where the spin picks up. The
       radius is not on an ease-out: a curve that is ninety per cent round in a
       fifth of the time makes a shape that is visibly a circle long before it
       is allowed to turn, which is the wait this animation exists to deny. */
    transition:
      border-radius 200ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 200ms linear,
      border-color 140ms linear 60ms;
  }

  .facade-go-tri {
    width: 0.625rem;
    height: 0.75rem;
    fill: var(--signal);
    /* A right-pointing triangle carries its weight left of the box that holds
       it, so a centred box leaves it looking adrift. A margin and not a
       transform: the transform belongs to the animation below. */
    margin-left: 2px;
    /* Gone before the square is a circle. A play mark inside a spinner is a
       control offering to start something that has started. */
    transition:
      opacity 120ms linear,
      transform 200ms cubic-bezier(0.4, 0, 1, 1);
  }

  .facade-go-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* A second line on the control, saying what pressing it gets you. */
  .facade-go-sub {
    font-family: var(--readout);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0;
  }

  /* ---- pressed: the two halves converge and the mark becomes a spinner ----

     The mark aims at the middle of the control; the label aims at the mark, and
     goes behind it. Along whichever axis the two sit on — which is what makes
     the same three rules carry the column layout below, where the label is under
     the mark rather than beside it. The distances are pixels measured at the
     press and written onto the elements as `--dx` / `--dy`, and the cut that
     hides the label as `--c*` / `--s*`; see `src/scripts/facade.js` for what
     each one is and why they are measured from `offsetLeft` rather than from a
     bounding box. */
  .facade-go.is-loading .facade-go-mark {
    animation: facade-converge 640ms both;
  }

  .facade-go.is-loading .facade-go-text {
    animation: facade-swallow 640ms both;
  }

  .facade-go.is-loading .facade-go-tri {
    opacity: 0;
    transform: scale(0.5);
  }

  .facade-go.is-loading .facade-go-ring {
    border-radius: 50%;
    /* Near enough to solid. The cut that hides the label sits on the circle's
       outline where the outline crosses the label's corner, so the middle rows
       of a letter spend nine pixels *under* the disc before they reach it — at
       72 % they went through it as a ghost, which is exactly the overlay this
       stopped being. */
    background: color-mix(in srgb, var(--ink) 94%, transparent);
    /* Two sides of four is half a circle: the arc that reads as motion, over a
       track faint enough to still read as the box it came from. */
    border-color: var(--signal) var(--signal) color-mix(in srgb, var(--signal) 14%, transparent)
      color-mix(in srgb, var(--signal) 14%, transparent);
    /* Delayed by exactly as long as the shape takes, and not a frame longer. A
       spinner that has finished becoming a spinner and is waiting to reach the
       middle of the picture before it turns is a stall in the one place the
       animation is there to say the opposite; it turns on its way across. */
    animation: facade-spin 900ms linear 200ms infinite;
  }

  /* Loaded. The whole control goes, spinner and scrim together, over the same
     320 ms the frame underneath takes to arrive. */
  .facade-go.is-done {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes facade-converge {
    0% {
      transform: translate(0, 0);
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    /* A short pull the other way first. It costs four per cent of the distance
       and is the difference between a thing that slides and a thing that goes. */
    20% {
      transform: translate(calc(var(--dx, 0px) * -0.07), calc(var(--dy, 0px) * -0.07));
      /* Not an ease-out. A curve that only decelerates puts nine tenths of the
         distance into the first third of the time and then coasts, which reads
         as a snap followed by nothing; this one takes the weight up and sets it
         down. */
      animation-timing-function: cubic-bezier(0.4, 0, 0.12, 1);
    }
    100% {
      transform: translate(var(--dx, 0px), var(--dy, 0px));
    }
  }

  /* The label does not fade and does not shrink. It slides into the disc and is
     cut off at the disc's edge, which is what "behind" means: the same three
     stops as the converge above, so that the cut — an inset that eats the label
     from the side it is travelling towards — stays on an edge that is itself
     moving. `--c*` is where that cut starts inside the label, negative for as
     long as the disc has not reached it, which is what the `max()` is for; `--s*`
     is how far it sweeps, and by the last stop it has swept the whole label. */
  @keyframes facade-swallow {
    0% {
      transform: translate(0, 0);
      clip-path: inset(max(0px, var(--ct, 0px)) 0 0 max(0px, var(--cl, 0px)));
      animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    }
    20% {
      transform: translate(calc(var(--dx, 0px) * -0.07), calc(var(--dy, 0px) * -0.07));
      clip-path: inset(
        max(0px, calc(var(--ct, 0px) + var(--st, 0px) * -0.07))
          max(0px, calc(var(--sr, 0px) * -0.07)) 0
          max(0px, calc(var(--cl, 0px) + var(--sl, 0px) * -0.07))
      );
      animation-timing-function: cubic-bezier(0.4, 0, 0.12, 1);
    }
    /* Two frames of opacity at the very end, where the label is already inside
       the disc and cannot be seen. It is not part of the effect — it is what
       keeps a browser that could not compute the cut from leaving the label
       lying across the picture for the whole of the wait. */
    98% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--dx, 0px), var(--dy, 0px));
      clip-path: inset(
        max(0px, calc(var(--ct, 0px) + var(--st, 0px))) max(0px, var(--sr, 0px)) 0
          max(0px, calc(var(--cl, 0px) + var(--sl, 0px)))
      );
      opacity: 0;
    }
  }

  @keyframes facade-spin {
    to {
      transform: rotate(1turn);
    }
  }

  @media (max-width: 560px) {
    /* At this width the label and the cost together are wider than the button,
       and the mark alone says enough. */
    .facade-go {
      flex-direction: column;
      gap: var(--s8);
      padding: var(--s16);
    }
    .facade-go-text {
      align-items: center;
      text-align: center;
    }
  }

  /* ---- on a phone the still is a photograph and nothing more ----

     Eight dense meters scaled to a 390 px screen are not legible; the
     application behind the control is two megabytes of compiled Flutter over
     whatever connection a phone happens to have; and an iframe that takes touch
     inside a document you are scrolling fights the scroll for every gesture. So
     there is nothing to press here, and the credit under the picture goes with
     the control — it is required of a page that *publishes* the programme, which
     is what pressing that control makes this one. See the note in the markup.

     Both orientations, which is what the second query is for: a phone on its
     side is 844 px wide and 390 px tall, so width alone would hand it the
     control its portrait screen was refused. The coarse pointer is what keeps a
     merely short desktop window out. A tablet is above both and still gets the
     real thing — it is a platform this application ships on. */
  @media (max-width: 720px), (max-height: 480px) and (pointer: coarse) {
    .facade-go,
    .hero-credit {
      display: none;
    }
  }

  /* Three across, not four. A meter is a dense picture and fourteen of them at
     a quarter of the page each is a contact sheet — at a third, the scale
     labels and the readouts inside them are legible without opening anything.
     The photographs are captured at four device pixels per logical one, which
     is what keeps them sharp at this size. */
  .cat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s32);
  }

  /* No panel of its own, and no title bar. Each photograph already carries the
     application's frame and its own title, so wrapping it in the website's
     version of both drew two borders around one module. */
  .cat-item {
    display: flex;
    flex-direction: column;
  }

  /* Every photograph is the same 360x236 frame, so nothing here has to line
     the fourteen up — they already are. The two bar meters are narrower than
     the frame and sit centred inside it, which the renderer does rather than
     the stylesheet: the letterboxing is invisible because the frame and the
     module share a background.

     Captured at three device pixels per logical one. Two put them at exactly
     1:1 on a retina display, which is no headroom — one notch of browser zoom
     and hairlines and six-pixel labels are being upscaled. */
  /* The mat around the picture. A meter photographed to the edge of its cell
     reads as a screenshot that has been cropped too tight; the space is what
     makes it a plate. It also fixes the displayed width, which the renderer is
     tuned to — see FRAME_W in scripts/render-modules.mjs. */
  .cat-shot {
    padding: var(--s24);
    background: var(--panel);
    border: 1px solid var(--hair);
  }

  .cat-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .cat-name {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text);
    margin: var(--s12) 0 0;
  }

  .cat-desc {
    font-family: var(--prose);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--faint);
    margin: var(--s4) 0 0;
  }

  /* ---------- the signal path ---------- */

  .flow-intro {
    margin-bottom: var(--s48);
  }

  .flow {
    display: grid;
    /* The connector's head is a square turned 45 degrees, so its point reaches
       half a diagonal out of the box it was laid out in — `(sqrt2 - 1) / 2` of
       its own side further on than the offset says. Unaccounted for, that
       overhang is measured *into* the plate the head is pointing at: the tip
       crossed the frame and landed on the picture. `--head-out` takes it back
       off, `--plate-edge` adds the plate's own hairline, and `--head-clear`
       holds the point off the frame by a readable amount — flush, the teal tip
       and the grey border met and read as one smudged corner. */
    --head: var(--s8);
    --head-out: calc(0.2072 * var(--head));
    --plate-edge: 1px;
    --head-clear: var(--s8);
    /* Set on the element from `flow.length`, because a stage whose photograph is
       missing is not drawn and three columns holding two plates would leave a
       third of the row empty. */
    grid-template-columns: repeat(var(--flow-n), minmax(0, 1fr));
    /* Four rows the stages share, so that the numbers, the pictures, the names
       and the paragraphs each start on one line across the whole row. Without
       it every stage is its own column and the row below the plates comes out
       ragged: the pictures are 1.39, 1.33 and 1.33 of their width and the
       tablet carries a bezel besides, so the three headings sat at three
       different heights — a dozen pixels apart, which is little enough to read
       as sloppy rather than as deliberate. */
    grid-template-rows: auto auto auto auto;
    gap: var(--s48);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flow-step {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  /* The plate keeps its own height inside the shared row rather than stretching
     to the tallest — stretching would put the difference back *inside* the
     frame, as a band of panel under the picture, which is the thing the plate
     is meant not to have. Out here it is a few pixels of page. */
  .flow-plate {
    align-self: start;
  }

  .flow-mark {
    display: flex;
    align-items: baseline;
    gap: var(--s12);
    padding-bottom: var(--s12);
    border-bottom: 1px solid var(--hair-strong);
    margin-bottom: var(--s16);
  }

  .flow-n {
    font-size: 0.75rem;
    color: var(--signal);
  }

  .flow-where {
    font-family: var(--display);
    font-size: 0.6875rem;
    font-weight: 600;
    font-variation-settings: 'wdth' 112;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1;
  }

  /* The plate, and the one box the connectors are hung from.
     Not `.module` — that frame is the application's own title bar and is
     reserved for things that are instrument-like, and a photograph of a module
     already has one inside it. Two nested title bars is one too many. */
  .flow-plate {
    position: relative;
    /* A `figure` carries `margin: 1em 40px` from the user-agent stylesheet, and
       40 px a side is enough to be obviously wrong and not enough to look like
       a bug: every plate sat narrower than the hairline over it and than the
       paragraph under it, on every width. */
    margin: 0;
    padding: var(--s16);
    background: var(--panel);
    border: 1px solid var(--hair);
  }

  /* `height: auto` is load-bearing, and its absence is invisible in the markup.
     Every picture here carries `width` and `height` attributes so its box has a
     shape before the file arrives — and those attributes are a definite height,
     which is enough to make `aspect-ratio` do nothing at all. The first version
     of this asked for a 4:3 box and got 550x862 instead: the plate stood twice
     as tall as the photograph inside it, with the picture floating in the middle
     of a field of panel. Letting the height follow the width is also the better
     answer to the three sources disagreeing about shape — 1.39 against 1.33 is a
     three per cent difference in plate height, which nobody can see, and it
     costs no letterboxing anywhere. */
  .flow-plate img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The tablet, as an object rather than as a screenshot.

     **This is the only border-radius on the site, and it is deliberate.** There
     is not another one outside the facade's play button, and the house rule is
     square corners, no shadows, no gradients — depth is a background step and a
     hairline. The exception holds because this radius is not a style applied to
     a surface: it is the shape of a real object, and a tablet drawn with square
     corners is a drawing of something else. It stays this narrow. If a second
     one is ever wanted somewhere, that is the moment to take this one out
     rather than to start a set. */
  .flow-device {
    padding: var(--s12);
    background: var(--raised);
    border-color: var(--hair-strong);
    border-radius: var(--s24);
  }

  .flow-device img {
    border-radius: var(--s8);
  }

  .flow-name {
    margin-top: var(--s24);
  }

  .flow-body {
    margin-top: var(--s12);
    font-size: 1rem;
  }

  /* The connector.

     Borrowed rather than invented: the plugin's own panel draws the link
     between the host and the app as a dashed line running out of its mark, and
     that panel is the first plate in this row. The page is repeating the
     product's drawing, which is the only reason it is allowed to be teal — the
     signal hue means a measurement on this site and nothing else, and what
     travels this line is measurements.

     Hung from the plate rather than from the step, so it sits on the middle of
     the picture whatever the heading above it does. It is static: the site has
     no ambient motion anywhere, an animated dash needs either a gradient or an
     SVG and the first is against the house rules, and the arrow already says
     which way the audio is going. */
  .flow-step + .flow-step .flow-plate::before,
  .flow-step + .flow-step .flow-plate::after {
    content: '';
    position: absolute;
    top: 50%;
    /* An absolutely positioned box is placed against its container's *padding*
       box, which is inside the border — so plain `right: 100%` starts the line
       a hairline in. The line leaves the plate behind it and stops short of the
       one ahead, which is the asymmetry the arrow is making anyway. */
    right: calc(100% + var(--plate-edge) + var(--head-clear));
  }

  .flow-step + .flow-step .flow-plate::before {
    width: calc(var(--s48) - var(--head-clear));
    border-top: 1px dashed var(--signal-dim);
  }

  /* The head, as two borders on a rotated square — no glyph, because an arrow
     typed as text is at the mercy of whatever face the host substitutes, which
     is the same trap the facade's play triangle is drawn to avoid. */
  .flow-step + .flow-step .flow-plate::after {
    width: var(--head);
    height: var(--head);
    right: calc(100% + var(--plate-edge) + var(--head-clear) + var(--head-out));
    border-top: 1px solid var(--signal);
    border-right: 1px solid var(--signal);
    transform: translateY(-50%) rotate(45deg);
  }

  /* ---------- catalogue ---------- */

  .mod-intro {
    margin-bottom: var(--s48);
  }

  /* ---------- measurement ---------- */

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: var(--s48);
    align-items: start;
  }

  .gate {
    position: sticky;
    top: calc(var(--s48) + var(--s16));
  }

  .gate-body {
    padding: var(--s16);
  }

  .gate-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gate-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s12);
    padding: var(--s8) 0;
    border-bottom: 1px solid var(--hair);
  }

  /* The note below the list draws the rule between them; a last row that
     also drew one put two hairlines sixteen pixels apart. */
  .gate-list li:last-child {
    border-bottom: 0;
  }

  .gate-k {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .gate-v {
    font-family: var(--readout);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .gate-os {
    padding-top: var(--s16);
    font-size: 0.6875rem;
    color: var(--faint);
    letter-spacing: 0.08em;
  }

  .gate-note {
    margin-top: var(--s16);
    padding-top: var(--s16);
    border-top: 1px solid var(--hair);
    font-family: var(--prose);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--faint);
  }

  .gate-note strong {
    color: var(--muted);
  }

  /* ---------- dynamics ---------- */

  /* Two columns of prose, and nothing else in the section. It held a readout
     panel on the right until the panel was cut; one column capped at the
     measure left half the section empty, which on a page where every other
     section fills its width reads as a picture that failed to arrive. */
  .dyn {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s48);
  }

  /* ---------- dynamics: the bands ---------- */

  /* Annex A.2 to scale: each band is as wide as it is long in LU, so the strip
     says at a glance that "loud" is two units wide and "wide" is open-ended.
     No colour ramp — the site draws no gradients, and the specification
     colours a reading against a delivery target's floor rather than against a
     fixed opinion — so the one colour is the streaming line at 13, which is
     arithmetic and not taste. The anchors sit on a rail above the strip as bare
     numerals, positioned to scale, and are explained in the legend beneath it,
     because a two-unit column has no width for a sentence. Below 980 px the
     segments stack into rows and the rail goes: the legend already says
     everything it did.

     A grid, not a flex row. A flex item's padding and hairline come out of the
     free space *before* it is shared by flex-grow, so each segment was its
     share of (width − 150 px) plus its own 25 px — and the boundary at 13 sat
     twenty pixels right of the tick above it. `fr` tracks divide the container
     itself, padding included, and `minmax(0, …)` keeps a nowrap range label
     from widening its track. The streaming line is a pseudo-element straddling
     the track edge by a pixel each side, rather than a border, which would sit
     entirely inside one segment and miss the tick by its own width. */
  .bands {
    margin-top: var(--s48);
    display: grid;
    gap: var(--s24);
  }

  .bands-lead {
    max-width: var(--measure);
  }

  .band-scale {
    position: relative;
    height: var(--s24);
    margin: 0 1px calc(-1 * var(--s24) + var(--s16));
  }

  .band-tick {
    position: absolute;
    left: calc(var(--at) / var(--scale) * 100%);
    bottom: 0;
    transform: translateX(-50%);
    padding-bottom: var(--s8);
    font-family: var(--readout);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--faint);
    white-space: nowrap;
  }
  .band-tick::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: var(--s4);
    background: var(--hair-strong);
  }
  .band-tick:first-child {
    transform: none;
  }
  .band-tick:first-child::after {
    left: 0;
  }
  .band-tick-line {
    color: var(--signal);
  }
  .band-tick-line::after {
    width: 2px;
    height: var(--s8);
    margin-left: -1px;
    background: var(--signal);
  }

  .band-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: var(--cols);
    border: 1px solid var(--hair-strong);
  }

  .band {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    padding: var(--s12) var(--s12) var(--s16);
    border-left: 1px solid var(--hair);
  }
  .band:first-child {
    border-left: 0;
  }
  .band:nth-child(even) {
    background: var(--panel);
  }
  .band-line::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    right: -1px;
    width: 2px;
    background: var(--signal);
  }
  .band-line + .band {
    border-left: 0;
  }

  .band-range {
    font-family: var(--readout);
    font-size: 0.6875rem;
    color: var(--faint);
  }
  .band-name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--text);
  }
  .band-note {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .band-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s8) var(--s24);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .band-legend-n {
    font-family: var(--readout);
    font-size: 0.75rem;
    color: var(--text);
    margin-right: var(--s4);
  }
  .band-legend-line .band-legend-n {
    color: var(--signal);
  }

  @media (max-width: 980px) {
    .band-scale {
      display: none;
    }
    .band-strip {
      grid-template-columns: minmax(0, 1fr);
    }
    .band {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-areas:
        'range name'
        'range note';
      column-gap: var(--s16);
      row-gap: var(--s4);
      padding: var(--s12) var(--s16);
      border-left: 0;
      border-top: 1px solid var(--hair);
    }
    .band:first-child {
      border-top: 0;
    }
    .band-range {
      grid-area: range;
      padding-top: 0.25em;
    }
    .band-name {
      grid-area: name;
    }
    .band-note {
      grid-area: note;
    }
    .band-line::after {
      top: auto;
      right: 0;
      bottom: -1px;
      left: 0;
      width: auto;
      height: 2px;
    }
    .band-line + .band {
      border-top: 0;
    }
  }

  /* ---------- reach ---------- */

  .reach {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s48);
    padding-bottom: var(--s48);
  }

  .reach-p {
    font-size: 0.9375rem;
    max-width: none;
  }

  .term-body,
  .json-body {
    margin: 0;
    padding: var(--s16);
    overflow-x: auto;
    font-family: var(--readout);
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--text);
    tab-size: 2;
  }

  .term-body .c {
    color: var(--signal);
    user-select: none;
  }

  .term-body .cm,
  .json-body .cm {
    color: var(--faint);
  }

  .json-body .k {
    color: var(--muted);
  }
  .json-body .s {
    color: var(--text);
  }
  .json-body .n {
    color: var(--signal);
  }

  /* ---------- configuration ---------- */

  .cfg {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--s48);
    align-items: start;
  }

  /* ---------- download ---------- */

  .dl-plug {
    font-size: 0.75rem;
    color: var(--signal);
    white-space: nowrap;
  }

  .dl .cta {
    margin-top: var(--s32);
  }

  /* ---------- responsive ---------- */

  @media (max-width: 1240px) {
    .cat {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Three buttons and two badges measure about 850 px. Rather than let the
     group tear at whatever width the text happens to run out — one badge up,
     one badge down, and a seam hanging off the end of the button row — it is
     sent to a line of its own just before that would start happening, and the
     seam goes with it: a vertical hairline at the start of a line separates
     nothing from anything. */
  @media (max-width: 980px) {
    .stores {
      flex-basis: 100%;
      margin-left: 0;
      padding-left: 0;
      margin-top: var(--s8);
    }

    .stores::before {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .hero {
      padding-block: var(--s48) var(--s64);
    }

    .split,
    .cfg,
    .dyn {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s32);
    }
    .gate {
      position: static;
    }
    .reach {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s32);
    }
    /* Stacked, the connector cannot stay on the plate: it would have to cross
       the previous step's description and its own step's heading to get there.
       It moves to the top of the step instead, standing in the grid gap between
       one stage's last line and the next one's number, which is where a reader
       going down the column actually crosses from one to the other. */
    .flow {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: var(--s32);
    }
    .flow-step {
      display: block;
      grid-row: auto;
      position: relative;
    }
    .flow-step + .flow-step .flow-plate::before,
    .flow-step + .flow-step .flow-plate::after {
      content: none;
