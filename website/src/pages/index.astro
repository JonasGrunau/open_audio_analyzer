  /* ---------- the signal path ---------- */

  .flow-intro {
    margin-bottom: var(--s48);
  }

  .flow {
    display: grid;
    /* The connector's head is a square turned 45 degrees, so its point reaches
       half a diagonal out of the box it was laid out in — `(sqrt2 - 1) / 2` of
       its own side further on than the offset says. Unaccounted for, that
       overhang is measured *into* the plate the head is pointing at: the tip
       crossed the frame and landed on the picture. `--head-out` takes it back
       off, `--plate-edge` adds the plate's own hairline, and `--head-clear`
       holds the point off the frame by a readable amount — flush, the teal tip
       and the grey border met and read as one smudged corner. */
    --head: var(--s8);
    --head-out: calc(0.2072 * var(--head));
    --plate-edge: 1px;
    --head-clear: var(--s8);
    /* Set on the element from `flow.length`, because a stage whose photograph is
       missing is not drawn and three columns holding two plates would leave a
       third of the row empty. */
    grid-template-columns: repeat(var(--flow-n), minmax(0, 1fr));
    /* Four rows the stages share, so that the numbers, the pictures, the names
       and the paragraphs each start on one line across the whole row. Without
       it every stage is its own column and the row below the plates comes out
       ragged: the pictures are 1.39, 1.33 and 1.33 of their width and the
       tablet carries a bezel besides, so the three headings sat at three
       different heights — a dozen pixels apart, which is little enough to read
       as sloppy rather than as deliberate. */
    grid-template-rows: auto auto auto auto;
    gap: var(--s48);
    list-style: none;
    margin: 0;
    padding: 0;
