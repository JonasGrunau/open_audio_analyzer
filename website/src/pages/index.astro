  /* The plate, and the one box the connectors are hung from.
     Not `.module` — that frame is the application's own title bar and is
     reserved for things that are instrument-like, and a photograph of a module
     already has one inside it. Two nested title bars is one too many. */
  .flow-plate {
    position: relative;
    /* A `figure` carries `margin: 1em 40px` from the user-agent stylesheet, and
       40 px a side is enough to be obviously wrong and not enough to look like
       a bug: every plate sat narrower than the hairline over it and than the
       paragraph under it, on every width. */
    margin: 0;
    padding: var(--s16);
    background: var(--panel);
    border: 1px solid var(--hair);
