     typed as text is at the mercy of whatever face the host substitutes, which
     is the same trap the facade's play triangle is drawn to avoid. */
  .flow-step + .flow-step .flow-plate::after {
    width: var(--head);
    height: var(--head);
    right: calc(100% + var(--plate-edge) + var(--head-clear) + var(--head-out));
    border-top: 1px solid var(--signal);
    border-right: 1px solid var(--signal);
    transform: translateY(-50%) rotate(45deg);
