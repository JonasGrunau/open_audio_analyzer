  .flow-step {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  /* The plate keeps its own height inside the shared row rather than stretching
     to the tallest — stretching would put the difference back *inside* the
     frame, as a band of panel under the picture, which is the thing the plate
     is meant not to have. Out here it is a few pixels of page. */
  .flow-plate {
    align-self: start;
