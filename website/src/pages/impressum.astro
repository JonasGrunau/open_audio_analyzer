        </p>
      </div>
    </article>
  </div>
</Base>

<style>
  /* The manual gives every h2 a rule above it, which is right in a four-hundred
     line document and wrong for the first heading of a page: it draws a line
     immediately under the blurb, and a second one on top of the border the
     translation already carries. */
  .md > h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  /* `address` is the right element for the four lines of an Anbieterkennzeichnung
     — it is what a machine reading this page for contact details looks for — and
     every browser italicises it, which is wrong for a postal address and wrong
     beside the rest of this page. The face is the readout one for the same
     reason a version number gets it: a street number and a telephone number are
     read digit by digit. */
  .legal-address {
    font-family: var(--readout);
    font-style: normal;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text);
  }

  /* The translation is a second document under the first, not a continuation of
     it, so it gets the rule the manual gives an h2 — the reader who wants the
     English should be able to find where it starts by scrolling past one line
     rather than by reading. */
  .legal-en {
    margin-top: var(--s64);
    padding-top: var(--s48);
    border-top: 1px solid var(--hair-strong);
  }
</style>
