# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Materialised by `flutter build`, not written by hand.
#
# pubspec.yaml declares the two typefaces by relative path into the application's
# own assets/fonts, because `OaaType` asks for the families by their bare names
# ('Inter', not 'packages/oaa/Inter') and only an application-level declaration
# gives them those. The Flutter tool resolves those `../../../` paths by copying
# the files in here — so this directory is a build product, and committing it
# would put a second copy of the fonts in the repository for something to drift
# from.
/assets/
