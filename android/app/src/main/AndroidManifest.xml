<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The remote display opens a TCP socket to an Open Audio Analyzer host. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Receiving mDNS answers needs multicast delivery, which Android's Wi-Fi
         driver filters out for an app that has not asked for it. This
         permission is what allows the WifiManager.MulticastLock that lifts the
         filter to be taken; taking it is a platform call, and the file that
         makes it is OaaMulticastLock.kt. Install-time, so there is no dialog.
         NEARBY_WIFI_DEVICES is deliberately not declared: it covers scanning
         and managing Wi-Fi networks, which this application never does. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- The host picker's QR scanner. Declared here as well as in
         mobile_scanner's own manifest, which the merger would supply
         anyway: a permission a user is asked for at runtime should be
         findable in the manifest of the application that asks. Runtime,
         so there is a dialog, and a refusal is a sentence in the panel
         rather than a camera that shows nothing. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- The input Open Audio Analyzer measures.

         **This was missing until 0.12.1, and its absence was silent.** The
         engine is compiled for Android with miniaudio in it exactly as it is
         for every other platform, so the canvas, the modules and the painters
         were all present and correct — and the one thing they had nothing to
         draw was a live signal, because AudioRecord cannot be constructed
         without this and miniaudio reports the failure as a device that will
         not open. It looked like the platform was display-only, and the
         documentation said so for a phase. It is the same class of failure as
         the multicast lock above: an Android capability that is absent rather
         than broken, with nothing in any log to say which.

         Runtime, so there is a dialog, and it is asked for when somebody
         chooses an input rather than at launch — a tablet that only ever
         mirrors another machine's meters is never asked at all. See
         OaaMicPermission.kt and lib/src/data/mic_permission.dart. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Tablets only, and this line is the whole of that decision.
         **There is no "tablet only" setting in the Play Console.** Google
         states a build's audience as "your manifest declarations and your
         console exclusion rules", and the Console's half of that is a device
         model picked out of the catalogue by hand, or a rule over RAM or
         System on a Chip. Neither of those is a screen, so looking for the
         setting there is looking for something that is not built — which costs
         an afternoon, because the Gerätekatalog page exists, has an
         "Ausschlussregeln verwalten" button on it, and simply does not offer
         the axis you came for.
         600dp is the sw600dp qualifier: the shortest edge of a 7 inch tablet.
         A handset is 320 to 480, so this is the line that separates them, and
         an unfolded foldable is above it and stays eligible.
         The system ignores this attribute at runtime — it changes nothing
         about how the application behaves on a device it is already on. It is
         read by the store and by the store only, which is what makes it
         untestable on hardware: the check is Play's device catalogue after an
         upload, and nothing before that will tell you it worked. -->
    <supports-screens android:requiresSmallestWidthDp="600"/>
    <application
        android:label="Audio Analyzer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
