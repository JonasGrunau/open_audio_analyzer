# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Workspace packages build their own artifacts.
packages/*/build/
packages/*/.dart_tool/

# `dart build cli` writes the CLI's bundle here — bin/oaa beside the engine as
# a shared library. `/build/` above only covers the application's.
cli/build/

# The engine's out-of-tree CMake build (C tests, Phase 1).
engine/build/

# The plugin's CMake build trees. Two, because they are not interchangeable:
# `build` has JUCE in it and `build-nojuce` is the framework-free configure that
# every push runs (-DOAA_BUILD_PLUGIN=OFF). Written out rather than globbed, so
# that a directory somebody adds under plugin/ with a name starting "build" is a
# decision rather than an accident.
plugin/build/
plugin/build-nojuce/

# JUCE, fetched rather than vendored. It is ~110 MB of framework that belongs
# to somebody else and is pinned by tag in plugin/CMakeLists.txt, so committing
# it would multiply the size of this repository to record a version number we
# already record in one line. CMake falls back to FetchContent when it is
# absent, so a fresh clone builds without doing anything special.
plugin/third_party/JUCE/

# The Creative Commons music `tool/fetch_test_audio.dart` downloads, and the
# attribution it writes beside it. Thirty megabytes of somebody else's audio
# that a one-line URL already records, and nothing in CI needs it — the
# end-to-end test generates its own signal.
test_audio/

# The plan and design docs are committed; scratch notes are not.
docs/scratch/

# flatpak-builder's `dir` source may not reach outside the manifest's own
# directory, so make_flatpak.sh copies a whole Flutter bundle in beside it and
# removes it again. Ignored because a failed run leaves it there, and it is
# forty megabytes of build output sitting in a source tree.
packaging/linux/flatpak/staging/

# Local agent/tooling state. Session-scoped and machine-specific, and the
# replay logs contain transcript content — never publish these.
# Leading ** so it matches inside the workspace packages too, not just the root.
**/.omc/

# Signing material, and this entry is the fix for a mistake rather than a
# precaution. Exporting a Developer ID from Keychain Access to base64 it into a
# CI secret leaves a .p12 in whatever directory you were standing in, and a
# `git add -A` from the repository root then commits a private key. That
# happened here; the only reason the key never left the machine is that the
# commit had not been pushed. Extensions rather than one filename, because the
# next export will be called something else.
*.p12
*.pfx
*.p8
*.keystore
*.jks
*.mobileprovision

# graphify's knowledge graph. Derived entirely from the tree it sits in — the
# post-commit hook rebuilds graph.json and GRAPH_REPORT.md from whatever the
# commit touched, so a tracked copy would be rewritten by the same commit that
# invalidated it and every diff would carry a few thousand regenerated lines.
# `.graphifyignore` is the input and *is* tracked: it defines the corpus, and a
# graph built from a different corpus is a different graph.
graphify-out/

# Claude Code's per-checkout state. `settings.json` here names a hook by its
# absolute path inside one developer's home directory, and `RESUME.md` is a
# pointer into one session's transcript and its checkpoint ref — neither means
# anything on another machine, and the first would silently fail to run there.
# Several sessions share this working tree, so this directory is rewritten by
# whichever one wrote last; project-wide settings belong in a tracked file that
# says so, not in a scratch directory a tool owns.
.claude/
