<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
	Deliberately NOT sandboxed — the reasoning is in Release.entitlements, and
	the two files must agree. A debug build that is sandboxed and a release build
	that is not would put a developer's configuration in a different directory
	from a user's, which is the kind of difference that gets discovered by a bug
	report nobody can reproduce.
-->
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The host picker's QR scanner. Required even though this app is
	     not sandboxed: a Developer ID build is signed with the hardened
	     runtime, which withholds the camera from a process that has not
	     asked for it here — and the refusal arrives as a camera that
	     never produces a frame rather than as an error. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
